# Copy to .env.local and fill in. Never commit .env.local.

# Public (sent to the browser)
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Free id from https://cloud.reown.com (only needed for mobile/WalletConnect wallets)
NEXT_PUBLIC_WC_PROJECT_ID=

# Server only
ANTHROPIC_API_KEY=
# Private key of the wallet that signs session scores
SCORE_SIGNER_PRIVATE_KEY=
# Upstash Redis (stores generated game configs)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
